# ══════════════════════════════════════════════════════════════
#  CoreExtract — Variáveis de Ambiente
#  1. Copie este arquivo: renomeie para .env
#  2. Preencha apenas GEMINI_API_KEY para começar
#  NUNCA comite o .env com dados reais no git.
# ══════════════════════════════════════════════════════════════

# ── Gemini API — Google AI Studio (obrigatório) ────────────────
# Como obter (30 segundos):
#   1. Acesse: aistudio.google.com/apikey
#   2. Clique em "Create API key"
#   3. Copie a chave abaixo (começa com AIza...)
GEMINI_API_KEY=AIzaSy_COLOQUE_SUA_CHAVE_AQUI

# Modelo (deixe como está para começar)
#   gemini-1.5-flash-latest  → rápido e gratuito (recomendado)
#   gemini-1.5-pro-latest    → mais poderoso, gratuito com limite menor
GEMINI_MODEL=gemini-1.5-flash-latest

# ── Gmail SMTP (opcional — só necessário para envio de e-mail) ─
# Seu endereço Gmail
GMAIL_USER=seuemail@gmail.com

# Senha de App (não é sua senha normal):
#   1. myaccount.google.com → Segurança → Verificação em 2 etapas (ativar)
#   2. Senhas de app → Outro → "CoreExtract" → copie os 16 caracteres
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

EMAIL_FROM_NAME=CoreExtract · RH Inteligente

# ── Servidor ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=*

# ── Limites ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=10
